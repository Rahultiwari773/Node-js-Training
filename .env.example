PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/employee_crud
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=9h
APP_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5000,http://localhost:5173
VERIFICATION_TOKEN_MINUTES=30
RESET_TOKEN_MINUTES=15

# Optional SMTP settings. Without these, email links are printed in the server console.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=your-email@example.com